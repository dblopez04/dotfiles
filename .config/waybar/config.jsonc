{
	"reload_style_on_change": true,
	"layer": "top",
	"modules-left": ["hyprland/workspaces"],
	"modules-right": ["mpris", "tray", "pulseaudio", "clock", "custom/power"],
	"hyprland/window": {
		"max-length": 50
	},
	"hyprland/workspaces": {
		"persistent-workspaces": {
			"1": [],
			"2": [],
			"3": [],
			"4": [],
			"5": [],
			"6": [],			
		}	
	},
	"custom/media": {
		"exec": "~/.config/waybar/media.sh",
		"interval": 2,
		"return-type": "json",
		"on-click": "playerctl play-pause",
		"max-length": 50
  	},
	"pulseaudio": {
		"format": "{icon}  {volume:2}%",
		"format-muted": "",
		"format-icons": {
			"headphones": "",
			"default": [
				"",
				""
			]
		},
		"on-click": "pavucontrol",
		"on-click-right": "pactl set-sink-mute $(pactl get-default-sink) toggle"
	},
	"clock": {
		"format": "{:%a %b %d %I:%M %p}",
        	"tooltip": false
	},
	"custom/power": {
		"format": "",
		"tooltip": false,
		"on-click": "nwg-bar",
	},

	"mpris": {
		"format": "{player_icon} {artist} - {title}",
		"format-paused": "{status_icon} <i>{artist} - {title}</i>",
		"player-icons": {
			"default": "▶",
			"mpv": "🎵"
		},
		"status-icons": {
			"paused": "⏸"
		},
		"max-length": 50,
	}
}
